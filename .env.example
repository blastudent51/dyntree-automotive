# Copy to .env.local for local development. Never commit real credentials.
# Obtain PostgreSQL connection strings from your Neon project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk: use a development instance locally, a production instance on your domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe test keys locally. Set webhook endpoint to /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_LIVE_PAYMENTS=false

# Explicitly local-only options. Both are rejected when NODE_ENV=production.
DEV_AUTH_ENABLED=true
DEV_PAYMENT_SIMULATION=true
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEV_SESSION_SECRET=

# Transactional email. No emails are sent unless Resend is configured.
RESEND_API_KEY=
EMAIL_FROM=Dyntree <reservations@your-verified-domain.example>
EMAIL_PROVIDER=console
# Required for authenticated invocation of /api/jobs/email
CRON_SECRET=

# Optional approved HTTPS host for administrator-managed external photography.
# Empty means local /public assets only. No arbitrary remote proxying.
IMAGE_CDN_HOST=

# Monthly vehicle subscriptions: separate from reservation deposits.
ENABLE_VEHICLE_SUBSCRIPTIONS=false
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
