{
  "name": "dyntree-automotive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm install",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "prisma generate",
    "dev:next": "next dev",
    "build:vercel": "prisma generate && next build",
    "start:vercel": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/run-env.mjs node_modules/.bin/prisma migrate deploy",
    "db:seed": "node scripts/run-env.mjs node --import tsx prisma/seed.ts",
    "db:studio": "node scripts/run-env.mjs node_modules/.bin/prisma studio",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build:vercel",
    "format": "prettier --write app components lib prisma/seed.ts tests scripts/*.ts scripts/*.mjs *.ts *.json docs/*.md",
    "test:db": "RUN_DB_TESTS=true vitest run tests/database.test.ts tests/api-flow.test.ts tests/subscriptions-db.test.ts",
    "admin:bootstrap": "node scripts/run-env.mjs node --import tsx scripts/bootstrap-admin.ts",
    "email:previews": "node --import tsx scripts/email-previews.ts",
    "assets:import": "node scripts/import-artwork.mjs",
    "assets:screens": "node scripts/create-screen-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "postinstall": "prisma generate",
    "dev:sites-preview": "node scripts/run-framework.mjs dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.9.2",
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "6.19.0",
    "@prisma/client": "6.19.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.2.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "resend": "^6.28.0",
    "sonner": "^2.0.8",
    "stripe": "22.6.2",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prisma": "6.19.0",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^5.0.0",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
